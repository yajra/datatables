{
  "name": "yajra/laravel-datatables",
  "description": "Laravel DataTables Complete Package.",
  "keywords": [
    "laravel",
    "datatables",
    "jquery"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Arjay Angeles",
      "email": "aqangeles@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "yajra/laravel-datatables-buttons": "^13",
    "yajra/laravel-datatables-editor": "^13",
    "yajra/laravel-datatables-export": "^13",
    "yajra/laravel-datatables-fractal": "^13",
    "yajra/laravel-datatables-html": "^13",
    "yajra/laravel-datatables-oracle": "^13"
  },
  "require-dev": {
    "larastan/larastan": "^3.1",
    "laravel/pint": "^1.21",
    "orchestra/testbench": "^11",
    "pestphp/pest": "^4",
    "pestphp/pest-plugin-laravel": "^4",
    "rector/rector": "^2.0.9"
  },
  "autoload-dev": {
    "psr-4": {
      "Yajra\\DataTables\\Installer\\Tests\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "13.x-dev"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "./vendor/bin/pest",
    "pint": "./vendor/bin/pint",
    "rector": "./vendor/bin/rector",
    "stan": "./vendor/bin/phpstan analyse --memory-limit=2G --ansi --no-progress --no-interaction --configuration=phpstan.neon.dist",
    "pr": [
      "@pint",
      "@rector",
      "@stan",
      "@test"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/yajra"
    }
  ]
}
